# Optional overrides for the main-site assistant (set as process environment variables).
# Conversation history and memory records are persisted under data/app_data/assistant.
CHAT_REDIS_URL=redis://127.0.0.1:6380/0

# The model selected on the main workspace takes precedence. These settings are
# the fallback when no main-site provider is configured (existing experiments/.env
# AI_CHAT_* settings are also read, without modifying that file).
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# Semantic memory retrieval uses these embedding settings. When absent, the existing
# experiments/.env embedding settings are read without modifying that directory.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
