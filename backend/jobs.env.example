# The web server checks a persistent collection schedule every 15 seconds.
# Set to 0 if a dedicated `collect_jobs.py --worker` process owns scheduling.
JOB_MARKET_SCHEDULER=1

# Optional: absolute Python path for the isolated JobHunter runtime.
# Otherwise the app checks data/app_data/jobhunter-runtime, then uses its own Python.
# JOBHUNTER_PYTHON=D:/program/career-agent/data/app_data/jobhunter-runtime/Scripts/python.exe

# Optional: Chromium/Chrome/Edge executable. Windows Chrome/Edge is detected automatically.
# Linux deployments can instead run: python -m playwright install --with-deps chromium
# JOBHUNTER_BROWSER=C:/Program Files/Google/Chrome/Application/chrome.exe
