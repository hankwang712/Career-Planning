      "liked_by": [
        "system"
      ],
      "replies": [
        {
          "id": "reply_backend_vs_algorithm_1",
          "content": "目标如果是实习，刷高频题到能过筛就够了，剩下时间优先补数据库、缓存和项目问答。",
          "created_at": 1775477600,
          "author": {
            "username": "java_offer",
            "display_name": "拿到后端暑期的同学"
          }
        },
        {
          "id": "reply_backend_vs_algorithm_2",
          "content": "算法和项目不是替代关系，建议你做一个 6 比 4 的时间分配，先保证每天都碰一点题。",
