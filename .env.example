# Copy this file to .env in the repository root. Never commit .env.
# Uses the same configuration keys as the local development setup.
# Main-site AI settings can also be entered in /system-settings by a system administrator.
# Website values override the environment for supported fields and take effect on the next request.
# Configure PostgreSQL here if you enable database-backed graph features.

# Model used by chat, resume analysis, career reports and the interview
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-flash

# Local Markdown file for the system's built-in resume rewriting Skill.
# RESUME_REWRITE_SKILL_PATH=/absolute/path/to/resume_rewrite.md

# Optional model for recruitment screening. Use a multimodal model to extract images as well.
CLEANER_LLM_API_KEY=
CLEANER_LLM_BASE_URL=
CLEANER_LLM_MODEL=

# Optional skill embeddings, separate from LightRAG
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=BAAI/bge-m3

# Optional career portrait and news embeddings
# TEXT_TO_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# TEXT_TO_IMAGE_API_KEY=
# NEWS_EMBEDDING_API_KEY=


# Resume and recruitment OCR
AI_OCR_API_KEY=
AI_OCR_BASE_URL=https://api.siliconflow.cn/v1
AI_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# LightRAG workspace
LIGHTRAG_WORKSPACE=career_jd

# LightRAG language model
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=
LLM_MODEL=deepseek-flash

# LightRAG embeddings
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

# Job retrieval reuses the embedding settings above; set 0 for local-only retrieval.
JOB_RETRIEVAL_GRAPH_ENABLED=1
# JOB_JD_SOURCE_PATH=D:/path/to/job_descriptions.txt

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=career
POSTGRES_PASSWORD=
POSTGRES_DATABASE=career_rag
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# LightRAG storage
WORKSPACE=career_jd
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LLM_BINDING=openai
EMBEDDING_BINDING=openai
SUMMARY_LANGUAGE=Chinese

# Set to 1 on a local desktop with an already authorized Chrome bridge on 127.0.0.1:3456.
CAREER_RECRUITMENT_USE_LOCAL_CHROME=0
