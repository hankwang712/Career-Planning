# Copy this file to .env in the repository root. Never commit .env.
# Uses the same configuration keys as the local development setup.
# Fill in API keys and the PostgreSQL password before starting.
# Main-site model settings take precedence over the AI_CHAT_* fallback.

# Conversation and report fallback
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-flash

# Semantic memory embeddings
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Resume and recruitment OCR
AI_OCR_API_KEY=
AI_OCR_BASE_URL=https://api.siliconflow.cn/v1
AI_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# Redis
MEMORY_REDIS_IMAGE=redis:6-alpine

# LightRAG workspace
LIGHTRAG_WORKSPACE=career_jd

# LightRAG language model
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=
LLM_MODEL=deepseek-flash

# LightRAG embeddings
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=career
POSTGRES_PASSWORD=
POSTGRES_DATABASE=career_rag
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# LightRAG storage
WORKSPACE=career_jd
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LLM_BINDING=openai
EMBEDDING_BINDING=openai
SUMMARY_LANGUAGE=Chinese
