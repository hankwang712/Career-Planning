# Copy to .env in the repository root. Never commit your .env.
# Explicit process variables take precedence. Main-site model settings take
# precedence over the AI_CHAT_* fallback for conversations and reports.

# Main application
HOST=0.0.0.0
PORT=8080
AUTO_OPEN_BROWSER=0
# APP_SECRET_KEY=
SESSION_COOKIE_SECURE=0
FRONTEND_ORIGIN=
USE_VITE_DEV_SERVER=0
VITE_DEV_SERVER_URL=

# Conversation / report fallback
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# Semantic chat memory
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
CHAT_REDIS_URL=redis://127.0.0.1:6380/0

# OCR
AI_OCR_BASE_URL=
AI_OCR_API_KEY=
AI_OCR_MODEL=
# TESSERACT_CMD=

# Optional image generation
TEXT_TO_IMAGE_API_KEY=
# TEXT_TO_IMAGE_BASE_URL=
# TEXT_TO_IMAGE_MODEL=
# PROFILE_PORTRAIT_MODEL=

# Optional news embedding
NEWS_EMBEDDING_API_KEY=

# Recruitment Radar optional extractors
RADAR_BROWSER_PROXY_URL=http://localhost:3456
RADAR_BROWSER_FALLBACK=1
RADAR_FIRECRAWL_API_KEY=
ANYSEARCH_API_KEY=
RADAR_ANYSEARCH_ENABLED=0

# Job collector: leave executable paths unset for automatic selection.
JOB_MARKET_SCHEDULER=1
# JOBHUNTER_PYTHON=
# JOBHUNTER_BROWSER=

# Redis container
MEMORY_REDIS_IMAGE=redis:7.4-alpine
MEMORY_REDIS_PORT=6380

# PostgreSQL / pgvector container
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=career
POSTGRES_PASSWORD=
POSTGRES_DATABASE=career_rag
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# Local LightRAG endpoint used by Agents
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_WORKSPACE=career_jd
LIGHTRAG_API_KEY=

# LightRAG model and storage configuration
LLM_BINDING=openai
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
LLM_MODEL=
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_TOKEN_LIMIT=8192
WORKSPACE=career_jd
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
SUMMARY_LANGUAGE=Chinese
