# 将所需项合并到 experiments/.env；不会自动读取本示例文件。
MEMORY_REDIS_URL=redis://127.0.0.1:6380/0
# Compose 镜像可通过启动器 --redis-image 覆盖，不修改 Docker 全局配置。
MEMORY_DATA_DIR=experiments/output/memory_advisor
MEMORY_RECENT_TURNS=6
MEMORY_SESSION_TTL=604800
MEMORY_HALF_LIFE_DAYS=90
MEMORY_RECALL_LIMIT=8
# 长期记忆使用显式 embedding；不下载 Chroma 默认模型。
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=
# LLM 复用 experiments/.env 中现有的 AI_CHAT_*。
