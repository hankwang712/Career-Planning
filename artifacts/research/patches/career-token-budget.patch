+import asyncio
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from lightrag.career.extraction import extract_job
+from lightrag.career.models import CareerExtraction, normalize_extraction
+from lightrag.career.transport import compact_json, decode_extraction, extraction_schema
+
+from .conftest import extraction, job
+
+pytestmark = pytest.mark.offline
+
+
+def wire(raw):
+    raw = copy.deepcopy(raw)
+    quotes = []
+
+    def convert(value):
+        if isinstance(value, dict):
+            for key, child in value.items():
+                if key in {"evidence", "level_evidence"}:
+                    for quote in child:
+                        if quote not in quotes:
+                            quotes.append(quote)
+                    value[key] = [quotes.index(quote) for quote in child]
+                else:
+                    convert(child)
+        elif isinstance(value, list):
+            for child in value:
+                convert(child)
+
+    convert(raw)
+    raw["quotes"] = quotes
+    return raw
+
+
+def test_shared_evidence_expands_to_identical_strict_facts(catalog):
+    original = extraction()
+    encoded = wire(original)
+    assert normalize_extraction(decode_extraction(compact_json(encoded)), job(), catalog) == normalize_extraction(
+        CareerExtraction.model_validate(original), job(), catalog
+    )
+    assert len(compact_json(encoded)) < len(compact_json(original))
+
+
+@pytest.mark.parametrize("reference", [-1, 999, True, "0", 0.0])
+def test_invalid_evidence_indexes_fail_closed(reference):
+    encoded = wire(extraction())
+    encoded["skills"][0]["evidence"] = [reference]
+    with pytest.raises(ValueError, match="indexes"):
+        decode_extraction(compact_json(encoded))
+
+
+def test_fabricated_quote_still_fails_literal_validation(catalog):
+    encoded = wire(extraction())
+    encoded["quotes"][0] = "fabricated responsibility"
+    with pytest.raises(ValueError, match="literal"):
+        normalize_extraction(decode_extraction(compact_json(encoded)), job(), catalog)
+
+
+@pytest.mark.anyio
+async def test_schema_and_catalog_are_a_stable_prefix(catalog):
+    calls = []
+
+    async def llm(prompt, **kwargs):
+        calls.append((json.loads(prompt), kwargs["system_prompt"]))
+        return compact_json(wire(extraction()))
+
+    await extract_job(llm, job(), catalog)
+    await extract_job(llm, job(2), catalog)
+    assert calls[0][1] == calls[1][1]
+    assert set(calls[0][0]) == {"jd"}
+    assert '"title":' not in compact_json(extraction_schema())
+
+
+def cache_class():
+    path = Path(__file__).resolve().parents[3] / "embedding_cache.py"
+    spec = importlib.util.spec_from_file_location("career_embedding_cache_test", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.EmbeddingCache
+
+
+@pytest.mark.anyio
+async def test_cache_deduplicates_batches_persists_and_isolates_models(tmp_path):
+    cls = cache_class()
+    path = tmp_path / "vectors.sqlite3"
+    calls = []
+
+    async def fetch(texts):
+        calls.append(texts)
+        return np.array([[len(t), 1] for t in texts], dtype=float)
+
+    def cache(**overrides):
+        config = dict(endpoint="http://offline", model="model-a", dimension=2, version="1")
+        config.update(overrides)
+        return cls(path, **config)
+
+    first = cache()
+    result = await first.embed(["Python", "SQL", "Python"], fetch)
+    assert calls == [["Python", "SQL"]]
+    assert result.tolist() == [[6, 1], [3, 1], [6, 1]]
+    await cache().embed(["SQL", "Python"], fetch)
+    assert len(calls) == 1
+    for config in [{"model": "model-b"}, {"endpoint": "http://other"}, {"version": "2"}]:
+        await cache(**config).embed(["Python"], fetch)
+    assert len(calls) == 4
+    await cache().embed(["Python"], fetch, context="query")
+    assert len(calls) == 5
+    assert first.usage()["reused_texts"] == 1
+
+
+@pytest.mark.anyio
+async def test_cache_rejects_bad_vectors_and_does_not_reuse_failed_requests(tmp_path):
+    cls = cache_class()
+    cache = cls(tmp_path / "vectors.sqlite3", endpoint="offline", model="a", dimension=2)
+
+    async def invalid(texts):
+        return [[float("nan"), 0]]
+
+    with pytest.raises(ValueError, match="shape or values"):
+        await cache.embed(["Python"], invalid)
+
+    calls = []
+
+    async def valid(texts):
+        calls.append(texts)
+        await asyncio.sleep(0)
+        return [[1, 2]]
+
+    await asyncio.gather(cache.embed(["Python"], valid), cache.embed(["Python"], valid))
+    assert len(calls) == 1
