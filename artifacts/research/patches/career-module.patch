+from __future__ import annotations
+
+import hashlib
+import json
+import time
+
+from .aggregate import aggregate, chunk_id
+from .models import SCHEMA_VERSION
+from .store import utc_now
+from .registry import EntityRegistry
+
+
+def _hash(value: str, prefix: str) -> str:
+    return prefix + hashlib.md5(value.encode()).hexdigest()
+
+
+async def validate_target(rag, store):
+    """Refuse foreign data, workspace overrides and unsupported writer semantics."""
+    if rag.graph_storage != "PGTableGraphStorage":
+        raise ValueError(
+            "Career projection currently supports PGTableGraphStorage only"
+        )
+    storages = [
+        rag.chunk_entity_relation_graph,
+        rag.entities_vdb,
+        rag.relationships_vdb,
+        rag.chunks_vdb,
+        rag.text_chunks,
+        rag.full_docs,
+        rag.doc_status,
+        rag.full_entities,
+        rag.full_relations,
+        rag.entity_chunks,
+        rag.relation_chunks,
+    ]
+    if rag.workspace != store.workspace or any(
+        storage.workspace != store.workspace for storage in storages
+    ):
+        raise ValueError(
+            "Career ledger and effective LightRAG storage workspaces differ; check PG_WORKSPACE"
+        )
+    await rag._raise_if_recovery_required()
+    nodes = await rag.chunk_entity_relation_graph.get_all_nodes()
+    if any(node.get("schema_version") != SCHEMA_VERSION for node in nodes):
+        raise ValueError(
+            "The target graph contains non-career data; choose an empty career workspace"
+        )
+    if any(
+        node.get("career_catalog_hash") != store.state()["catalog_hash"]
+        for node in nodes
+    ):
+        raise ValueError("The target graph was built with a different career catalog")
+    from lightrag.base import DocStatus
+
+    rows = await rag.doc_status.get_docs_by_statuses(list(DocStatus), strict=True)
+    for identifier, row in rows.items():
+        metadata = row.get("metadata", {}) if isinstance(row, dict) else row.metadata
+        if metadata.get("career_schema") != SCHEMA_VERSION:
+            raise ValueError(
+                "The target workspace contains documents from a different ingestion pipeline"
+            )
+        known = store.get(identifier)
+        if known is None or known["status"] != "extracted":
+            raise ValueError(
+                "The career fact ledger is missing a projected JD; restore its matching ledger before publishing"
+            )
+
+
+async def project(rag, store, *, force_reindex=False) -> dict:
+    """Caller holds CareerStore.writer; replay completely after a partial failure.
+
+    Facts stay immutable; versioned entity redirects may change the projection.
+    Anchor supersets and a durable object manifest survive partial failures.
+    Obsolete derived objects are removed before anchors shrink or status completes.
+    """
+    await validate_target(rag, store)
+    documents = store.documents()
+    graph = aggregate(documents)
+    revision = store.state()["revision"]
+    store.projection_started()
+    registry = EntityRegistry(store)
+    previous_payloads = registry.payloads()
+    current_payloads = {}
+    vector_upserts = {}
+
+    def changed_vectors(kind, values):
+        changed = {}
+        for identifier, value in values.items():
+            encoded = json.dumps(
+                {
+                    "payload": value,
+                    "model": rag.embedding_func.model_name,
+                    "dimension": rag.embedding_func.embedding_dim,
+                },
+                sort_keys=True,
+                ensure_ascii=False,
+            )
+            digest = hashlib.sha256(encoded.encode()).hexdigest()
+            key = (kind, identifier)
+            current_payloads[key] = digest
+            if force_reindex or previous_payloads.get(key) != digest:
+                changed[identifier] = value
+        vector_upserts[kind] = len(changed)
+        return changed
+
+    def vector_text(value):
+        # Only the search representation is bounded. Original JDs and all facts
+        # remain intact in the ledger and graph properties.
+        tokens = rag.tokenizer.encode(value)
+        maximum = rag.embedding_func.max_token_size
+        return (
+            rag.tokenizer.decode(tokens[:maximum])
+            if maximum and len(tokens) > maximum
+            else value
+        )
+
+    async def upsert_batches(storage, values, size=64):
+        items = list(values.items())
+        for offset in range(0, len(items), size):
+            await storage.upsert(dict(items[offset : offset + size]))
+
+    async def flush(*storages):
+        for storage in storages:
+            await storage.index_done_callback()
+
+    try:
+        previous = registry.manifest()
+        previous_nodes = set(previous["nodes"])
+        previous_nodes.update(
+            node["id"] for node in await rag.chunk_entity_relation_graph.get_all_nodes()
+        )
+        previous_edges = {tuple(sorted(pair)) for pair in previous["edges"]}
+        previous_edges.update(
+            tuple(sorted((edge["source"], edge["target"])))
+            for edge in await rag.chunk_entity_relation_graph.get_all_edges()
+        )
+        full_docs, chunks, statuses, entities_anchor, relations_anchor = (
+            {},
+            {},
+            {},
+            {},
+            {},
+        )
+        for doc in documents:
+            job = doc["job"]
+            identifier = chunk_id(job)
+            full_docs[job.jd_id] = {"content": job.text, "file_path": job.file_path}
+            chunks[identifier] = {
+                "content": job.chunk_text,
+                "tokens": len(rag.tokenizer.encode(job.chunk_text)),
+                "chunk_order_index": 0,
+                "full_doc_id": job.jd_id,
+                "file_path": job.file_path,
+                "llm_cache_list": [],
+            }
+            existing = await rag.doc_status.get_by_id(job.jd_id) or {}
+            metadata = {
+                **existing.get("metadata", {}),
+                "career_schema": SCHEMA_VERSION,
+                "career_revision": revision,
+                "career_metadata": job.model_dump(exclude={"text"}),
+            }
+            if not existing:
+                metadata["kg_write_state"] = "pre_graph"
+            statuses[job.jd_id] = {
+                "content_summary": job.text[:100],
+                "content_length": len(job.text),
+                "status": "processing",
+                "file_path": job.file_path,
+                "created_at": doc["created_at"],
+                "updated_at": utc_now(),
+                "chunks_count": 1,
+                "chunks_list": [identifier],
+                "metadata": metadata,
+            }
+            anchors = graph["anchors"][job.jd_id]
+            entities_anchor[job.jd_id] = {
+                "entity_names": anchors["entity_names"],
+                "count": len(anchors["entity_names"]),
+            }
+            relations_anchor[job.jd_id] = {
+                "relation_pairs": anchors["relation_pairs"],
+                "count": len(anchors["relation_pairs"]),
+            }
+        expected_entities = {
+            key: {**value, "entity_names": value["entity_names"][:]}
+            for key, value in entities_anchor.items()
+        }
+        expected_relations = {
+            key: {**value, "relation_pairs": value["relation_pairs"][:]}
+            for key, value in relations_anchor.items()
+        }
+        for identifier in entities_anchor:
+            old_entities = await rag.full_entities.get_by_id(identifier) or {}
+            old_relations = await rag.full_relations.get_by_id(identifier) or {}
+            names = set(old_entities.get("entity_names", []))
+            pairs = {
+                tuple(sorted(pair)) for pair in old_relations.get("relation_pairs", [])
+            }
+            previous_nodes.update(names)
+            previous_edges.update(pairs)
+            names.update(entities_anchor[identifier]["entity_names"])
+            pairs.update(
+                tuple(sorted(pair))
+                for pair in relations_anchor[identifier]["relation_pairs"]
+            )
+            entities_anchor[identifier] = {
+                "entity_names": sorted(names),
+                "count": len(names),
+            }
+            relations_anchor[identifier] = {
+                "relation_pairs": sorted(pairs),
+                "count": len(pairs),
+            }
+        new_nodes = set(graph["nodes"])
+        new_edges = {tuple(sorted(pair)) for pair in graph["edges"]}
+        registry.save_manifest(previous_nodes | new_nodes, previous_edges | new_edges)
+        await upsert_batches(rag.doc_status, statuses)
+        await upsert_batches(rag.full_docs, full_docs)
+        await upsert_batches(rag.text_chunks, chunks)
+        await upsert_batches(rag.chunks_vdb, changed_vectors("chunks", chunks))
+        await flush(rag.doc_status, rag.full_docs, rag.text_chunks, rag.chunks_vdb)
+        await upsert_batches(rag.full_entities, entities_anchor)
+        await upsert_batches(rag.full_relations, relations_anchor)
+        await flush(rag.full_entities, rag.full_relations)
+        for status in statuses.values():
+            status["metadata"]["kg_write_state"] = "graph_mutation_started"
+        await upsert_batches(rag.doc_status, statuses)
+        await flush(rag.doc_status)
+
+        entity_vectors, relation_vectors, entity_tracking, relation_tracking = (
+            {},
+            {},
+            {},
+            {},
+        )
+        graph_nodes, graph_edges = [], []
+        source_paths = {chunk_id(doc["job"]): doc["job"].file_path for doc in documents}
+        for identifier, entry in graph["nodes"].items():
+            source_id = "<SEP>".join(entry["source_ids"])
+            attrs = {
+                **entry,
+                "entity_id": identifier,
+                "source_id": source_id,
+                "created_at": int(time.time()),
+                "career_catalog_hash": store.state()["catalog_hash"],
+                "file_path": "<SEP>".join(
+                    sorted({source_paths[source] for source in entry["source_ids"]})
+                ),
+            }
+            graph_nodes.append((identifier, attrs))
+            entity_vectors[_hash(identifier, "ent-")] = {
+                "entity_name": identifier,
+                "entity_type": entry["entity_type"],
+                "description": entry["description"],
+                "source_id": source_id,
+                "file_path": attrs["file_path"],
+                "content": vector_text(
+                    f"{entry['name']}\nAliases: {', '.join(entry['aliases'])}\n{entry['description']}"
+                ),
+            }
+            entity_tracking[identifier] = {
+                "chunk_ids": entry["source_ids"],
+                "count": len(entry["source_ids"]),
+            }
+        from lightrag.utils import make_relation_chunk_key
+
+        for (src, tgt), entry in graph["edges"].items():
+            source_id = "<SEP>".join(entry["source_ids"])
+            topic = {
+                "REQUIRES_SKILL": "岗位技能要求,职业能力",
+                "PERFORMS_TASK": "工作职责,工作任务",
+                "USES_SKILL": "任务技能应用",
+            }[entry["relation_type"]]
+            attrs = {
+                **entry,
+                "source_id": source_id,
+                "keywords": f"{topic},{entry['relation_type']},{graph['nodes'][src]['name']},{graph['nodes'][tgt]['name']}",
+                "file_path": "<SEP>".join(
+                    sorted({obs["file_path"] for obs in entry["observations"]})
+                ),
+                "created_at": int(time.time()),
+            }
+            graph_edges.append((src, tgt, attrs))
+            a, b = sorted((src, tgt))
+            relation_vectors[_hash(a + b, "rel-")] = {
+                "src_id": a,
+                "tgt_id": b,
+                "source_id": source_id,
+                "file_path": attrs["file_path"],
+                "content": vector_text(f"{attrs['keywords']}\n{entry['description']}"),
+            }
+            relation_tracking[make_relation_chunk_key(src, tgt)] = {
+                "chunk_ids": entry["source_ids"],
+                "count": len(entry["source_ids"]),
+            }
+        await upsert_batches(rag.entity_chunks, entity_tracking)
+        await upsert_batches(rag.relation_chunks, relation_tracking)
+        await flush(rag.entity_chunks, rag.relation_chunks)
+        for offset in range(0, len(graph_nodes), 128):
+            await rag.chunk_entity_relation_graph.upsert_nodes_batch(
+                graph_nodes[offset : offset + 128]
+            )
+        for offset in range(0, len(graph_edges), 128):
+            await rag.chunk_entity_relation_graph.upsert_edges_batch(
+                graph_edges[offset : offset + 128]
+            )
+        await upsert_batches(
+            rag.entities_vdb, changed_vectors("entities", entity_vectors)
+        )
+        await upsert_batches(
+            rag.relationships_vdb, changed_vectors("relations", relation_vectors)
+        )
+        await flush(
+            rag.chunk_entity_relation_graph, rag.entities_vdb, rag.relationships_vdb
+        )
+        obsolete_edges = sorted(previous_edges - new_edges)
+        obsolete_nodes = sorted(previous_nodes - new_nodes)
+        if obsolete_edges:
+            await rag.chunk_entity_relation_graph.remove_edges(obsolete_edges)
+            await rag.relationships_vdb.delete(
+                list(
+                    {
+                        _hash(a + b, "rel-")
+                        for src, tgt in obsolete_edges
+                        for a, b in ((src, tgt), (tgt, src))
+                    }
+                )
+            )
+            await rag.relation_chunks.delete(
+                [make_relation_chunk_key(src, tgt) for src, tgt in obsolete_edges]
+            )
+        if obsolete_nodes:
+            await rag.chunk_entity_relation_graph.remove_nodes(obsolete_nodes)
+            await rag.entities_vdb.delete(
+                [_hash(identifier, "ent-") for identifier in obsolete_nodes]
+            )
+            await rag.entity_chunks.delete(obsolete_nodes)
+        await flush(
+            rag.chunk_entity_relation_graph,
+            rag.entities_vdb,
+            rag.relationships_vdb,
+            rag.entity_chunks,
+            rag.relation_chunks,
+        )
+        # Only now can the old attribution carriers stop naming removed objects.
+        remaining_nodes = {
+            node["id"] for node in await rag.chunk_entity_relation_graph.get_all_nodes()
+        }
+        remaining_edges = {
+            tuple(sorted((edge["source"], edge["target"])))
+            for edge in await rag.chunk_entity_relation_graph.get_all_edges()
+        }
+        if remaining_nodes != new_nodes or remaining_edges != new_edges:
+            raise RuntimeError(
+                "Career graph differs from the expected projection after merge cleanup"
+            )
+        for identifier in obsolete_nodes:
+            if await rag.entity_chunks.get_by_id(identifier) is not None:
+                raise RuntimeError(
+                    "An obsolete entity tracking record could not be removed"
+                )
+        for src, tgt in obsolete_edges:
+            if (
+                await rag.relation_chunks.get_by_id(make_relation_chunk_key(src, tgt))
+                is not None
+            ):
+                raise RuntimeError(
+                    "An obsolete relation tracking record could not be removed"
+                )
+        await upsert_batches(rag.full_entities, expected_entities)
+        await upsert_batches(rag.full_relations, expected_relations)
+        await flush(rag.full_entities, rag.full_relations)
+        for status in statuses.values():
+            status.update(status="processed", updated_at=utc_now())
+        await upsert_batches(rag.doc_status, statuses)
+        await flush(rag.doc_status)
+        registry.save_manifest(new_nodes, new_edges)
+        registry.save_payloads(current_payloads)
+        store.projection_finished(revision)
+        return {
+            "revision": revision,
+            "documents": len(documents),
+            "nodes": len(graph_nodes),
+            "edges": len(graph_edges),
+            "removed_nodes": len(obsolete_nodes),
+            "removed_edges": len(obsolete_edges),
+            "vector_upserts": vector_upserts,
+        }
+    except BaseException as error:
+        store.projection_failed(type(error).__name__)
+        raise
