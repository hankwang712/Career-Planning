@@ -0,0 +1,58 @@
+from copy import deepcopy
+import json
+
+from .models import CareerExtraction
+
+
+def compact_json(value):
+    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+
+
+def extraction_schema():
+    schema = deepcopy(CareerExtraction.model_json_schema())
+
+    def visit(value):
+        if isinstance(value, dict):
+            value.pop("title", None)
+            for name, prop in value.get("properties", {}).items():
+                if name in {"evidence", "level_evidence"}:
+                    prop["items"] = {"type": "integer", "minimum": 0}
+            for child in value.values():
+                visit(child)
+        elif isinstance(value, list):
+            for child in value:
+                visit(child)
+
+    visit(schema)
+    schema["properties"]["quotes"] = {"type": "array", "items": {"type": "string"}}
+    schema["required"].append("quotes")
+    return schema
+
+
+def decode_extraction(content):
+    data = json.loads(content)
+    # Accept existing callers/recorded responses without a format migration.
+    if not isinstance(data, dict) or "quotes" not in data:
+        return CareerExtraction.model_validate(data)
+    quotes = data.pop("quotes")
+    if not isinstance(quotes, list) or any(type(q) is not str for q in quotes):
+        raise ValueError("quotes must be an array of literal JD strings")
+
+    def expand(value):
+        if isinstance(value, dict):
+            for name, child in value.items():
+                if name in {"evidence", "level_evidence"}:
+                    if not isinstance(child, list) or any(
+                        type(ref) is not int or not 0 <= ref < len(quotes)
+                        for ref in child
+                    ):
+                        raise ValueError(f"{name} must reference valid zero-based quotes indexes")
+                    value[name] = [quotes[ref] for ref in child]
+                else:
+                    expand(child)
+        elif isinstance(value, list):
+            for child in value:
+                expand(child)
+
+    expand(data)
+    return CareerExtraction.model_validate(data)
