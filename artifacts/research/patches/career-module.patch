+++ b/lightrag/career/aggregate.py
@@ -0,0 +1,348 @@
+from collections import defaultdict
+import hashlib
+import json
+
+from .models import LEVEL_NAMES, SCHEMA_VERSION
+from .registry import canonical_id
+
+
+def chunk_id(job) -> str:
+    return "chunk-" + hashlib.md5(job.chunk_text.encode()).hexdigest()
+
+
+def aggregate(documents: list[dict]) -> dict:
+    nodes, edges = {}, {}
+    role_docs = defaultdict(set)
+    anchors = {}
+
+    def node(identifier, kind, name, job, evidence, **attrs):
+        entry = nodes.setdefault(
+            identifier,
+            {
+                "id": identifier,
+                "entity_type": kind,
+                "name": name,
+                "canonical_id": canonical_id(identifier),
+                "aliases": [],
+                "schema_version": SCHEMA_VERSION,
+                "_sources": set(),
+                "_jds": set(),
+                "evidence": [],
+                **attrs,
+            },
+        )
+        entry["_sources"].add(chunk_id(job))
+        entry["_jds"].add(job.jd_id)
+        entry["aliases"] = sorted(
+            set(entry["aliases"]) | set(attrs.get("aliases", [name]))
+        )
+        if kind == "Skill":
+            entry["categories"] = sorted(
+                set(entry["categories"]) | set(attrs.get("categories", []))
+            )
+        entry["evidence"].extend(
+            {"jd_id": job.jd_id, "source_id": chunk_id(job), **q} for q in evidence
+        )
+        return identifier
+
+    def edge(src, tgt, relation, job, evidence, **attrs):
+        entry = edges.setdefault(
+            (src, tgt),
+            {
+                "source": src,
+                "target": tgt,
+                "relation_type": relation,
+                "logical_source_id": src,
+                "logical_target_id": tgt,
+                "schema_version": SCHEMA_VERSION,
+                "observations": [],
+            },
+        )
+        entry["observations"].append(
+            {
+                "jd_id": job.jd_id,
+                "source_id": chunk_id(job),
+                "file_path": job.file_path,
+                "evidence": evidence,
+                **attrs,
+            }
+        )
+
+    for doc in documents:
+        job, facts = doc["job"], doc["facts"]
+        doc_nodes, doc_edges = set(), set()
+        role = facts["role"]
+        if role is not None:
+            role_docs[role["id"]].add(job.jd_id)
+            role_id = node(
+                role["id"],
+                "Role",
+                f"{role['name']} · {LEVEL_NAMES[role['level']]}",
+                job,
+                role["evidence"],
+                family=role["family"],
+                level=role["level"],
+            )
+            doc_nodes.add(role_id)
+            skills = {skill["name"]: skill for skill in facts["skills"]}
+
+            def add_skill(name):
+                skill = skills[name]
+                identifier = node(
+                    skill["id"],
+                    "Skill",
+                    name,
+                    job,
+                    skill["evidence"],
+                    categories=skill["categories"],
+                    aliases=skill.get("aliases", [name]),
+                )
+                doc_nodes.add(identifier)
+                return identifier
+
+            for group in facts["requirements"]:
+                for name in group["skills"]:
+                    identifier = add_skill(name)
+                    edge(
+                        role_id,
+                        identifier,
+                        "REQUIRES_SKILL",
+                        job,
+                        group["evidence"],
+                        group_id=group["group_id"],
+                        group_skills=group["skills"],
+                        original_group_skills=group.get(
+                            "original_skills", group["skills"]
+                        ),
+                        operator=group["operator"],
+                        requirement_type=group["requirement_type"],
+                        proficiency=group["proficiency"],
+                    )
+                    doc_edges.add(tuple(sorted((role_id, identifier))))
+            for task in facts["tasks"]:
+                task_id = node(
+                    task["id"],
+                    "Task",
+                    task["name"],
+                    job,
+                    task["evidence"],
+                    aliases=task.get("aliases", [task["name"]]),
+                )
+                doc_nodes.add(task_id)
+                edge(role_id, task_id, "PERFORMS_TASK", job, task["evidence"])
+                doc_edges.add(tuple(sorted((role_id, task_id))))
+                for use in task["uses"]:
+                    skill_id = add_skill(use["skill"])
+                    edge(task_id, skill_id, "USES_SKILL", job, use["evidence"])
+                    doc_edges.add(tuple(sorted((task_id, skill_id))))
+        anchors[job.jd_id] = {
+            "entity_names": sorted(doc_nodes),
+            "relation_pairs": sorted(doc_edges),
+        }
+
+    for entry in nodes.values():
+        entry["source_ids"] = sorted(entry.pop("_sources"))
+        entry["source_jd_ids"] = sorted(entry.pop("_jds"))
+        entry["support_jd_count"] = len(entry["source_jd_ids"])
+        entry["evidence"] = list(
+            {
+                json.dumps(q, sort_keys=True, ensure_ascii=False): q
+                for q in entry["evidence"]
+            }.values()
+        )
+        if entry["entity_type"] == "Role":
+            entry["total_jd_count"] = len(role_docs[entry["id"]])
+        sample = "；".join(q["quote"] for q in entry["evidence"][:3])
+        entry["description"] = (
+            f"{entry['name']}；类型={entry['entity_type']}；来源JD数={entry['support_jd_count']}。"
+            f"招聘样本原文示例：{sample}"
+        )
+    for entry in edges.values():
+        observations = entry["observations"]
+        sources = sorted({obs["source_id"] for obs in observations})
+        positive = {
+            obs["jd_id"]
+            for obs in observations
+            if obs.get("requirement_type") != "negated"
+        }
+        required = {
+            obs["jd_id"]
+            for obs in observations
+            if obs.get("requirement_type") == "required"
+            and obs.get("operator") == "AND"
+        }
+        # Each category counts distinct JDs, never the number of evidence quotes.
+        type_counts = {
+            kind: len(
+                {
+                    obs["jd_id"]
+                    for obs in observations
+                    if obs.get("requirement_type") == kind
+                }
+            )
+            for kind in ("required", "preferred", "mentioned", "negated", "uncertain")
+        }
+        operator_counts = {
+            op: len({obs["jd_id"] for obs in observations if obs.get("operator") == op})
+            for op in ("AND", "OR", "EXAMPLE_SET", "ALTERNATIVE_UNCONFIRMED")
+        }
+        denominator = (
+            len(role_docs[entry["source"]])
+            if entry["source"] in role_docs
+            else nodes[entry["source"]]["support_jd_count"]
+        )
+        entry.update(
+            source_ids=sources,
+            source_jd_ids=sorted({obs["jd_id"] for obs in observations}),
+            support_jd_count=len(positive),
+            total_jd_count=denominator,
+            mention_rate=len(positive) / denominator if denominator else 0,
+            individually_required_jd_count=len(required),
+            requirement_type_jd_counts=type_counts,
+            operator_jd_counts=operator_counts,
+            weight=float(len(sources)),
+        )
+        sample = "；".join(
+            q["quote"] for obs in observations[:3] for q in obs["evidence"][:1]
+        )
+        entry["description"] = (
+            f"{nodes[entry['source']]['name']} —{entry['relation_type']}→ {nodes[entry['target']]['name']}。"
+            f"样本提及率={len(positive)}/{denominator}，不代表必备率或市场比例；"
+            f"明确单项要求JD数={len(required)}；条件类型JD数={type_counts}；逻辑组JD数={operator_counts}。"
+            f"条件须按来源JD内的要求组解释，不能把OR或示例集拆为单项必备。原文示例：{sample}"
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "nodes": nodes,
+        "edges": edges,
+        "anchors": anchors,
+        "role_documents": {key: sorted(value) for key, value in role_docs.items()},
+    }
+
+
+def profile(graph: dict, role_id: str) -> dict:
+    role = graph["nodes"].get(role_id)
+    if not role or role["entity_type"] != "Role":
+        raise ValueError("Unknown Role ID; list available roles first")
+    edges = [edge for edge in graph["edges"].values() if edge["source"] == role_id]
+    return {
+        "role": role,
+        "skills": sorted(
+            (edge for edge in edges if edge["relation_type"] == "REQUIRES_SKILL"),
+            key=lambda edge: (-edge["mention_rate"], edge["target"]),
+        ),
+        "tasks": [edge for edge in edges if edge["relation_type"] == "PERFORMS_TASK"],
+        "scope": "仅所选JD样本；提及率不等于必备率或市场比例；未知发布日期不代表仍在招聘。",
+    }
+
+
+def similar_roles(graph: dict, role_id: str, limit: int = 10) -> list[dict]:
+    if not 1 <= limit <= 100:
+        raise ValueError("Similar role limit must be between 1 and 100")
+    profile(graph, role_id)
+    signatures = defaultdict(lambda: {"skills": set(), "tasks": set()})
+    for edge in graph["edges"].values():
+        if edge["relation_type"] == "REQUIRES_SKILL" and edge["support_jd_count"]:
+            signatures[edge["source"]]["skills"].add(edge["target"])
+        elif edge["relation_type"] == "PERFORMS_TASK":
+            signatures[edge["source"]]["tasks"].add(edge["target"])
+    left = signatures[role_id]
+    results = []
+    for identifier, node in graph["nodes"].items():
+        if node["entity_type"] != "Role" or identifier == role_id:
+            continue
+        right = signatures[identifier]
+        scores = {}
+        for kind in ("skills", "tasks"):
+            union = left[kind] | right[kind]
+            scores[kind] = len(left[kind] & right[kind]) / len(union) if union else None
+        measured = [score for score in scores.values() if score is not None]
+        score = sum(measured) / len(measured) if measured else 0
+        if score > 0:
+            results.append(
+                {
+                    "role_id": identifier,
+                    "name": node["name"],
+                    "sample_overlap": score,
+                    "skill_jaccard": scores["skills"],
+                    "task_jaccard": scores["tasks"],
+                    "shared_skills": sorted(left["skills"] & right["skills"]),
+                    "shared_tasks": sorted(left["tasks"] & right["tasks"]),
+                    "source_jd_count": graph["nodes"][role_id]["total_jd_count"],
+                    "target_jd_count": node["total_jd_count"],
+                    "scope": "基于技能提及和任务集合的样本重合度，非转岗成功率或晋升关系。",
+                }
+            )
+    return sorted(results, key=lambda row: (-row["sample_overlap"], row["role_id"]))[
+        :limit
+    ]
+
+
+def compare_roles(
+    documents: list[dict], source: str, target: str, owned: set[str] | None = None
+) -> dict:
+    graph = aggregate(documents)
+    left, right = profile(graph, source), profile(graph, target)
+
+    def positive_skills(data):
+        return {
+            edge["target"].removeprefix("Skill::")
+            for edge in data["skills"]
+            if edge["support_jd_count"]
+        }
+
+    left_skills, right_skills = positive_skills(left), positive_skills(right)
+    left_tasks = {edge["target"].removeprefix("Task::") for edge in left["tasks"]}
+    right_tasks = {edge["target"].removeprefix("Task::") for edge in right["tasks"]}
+
+    def jaccard(a, b):
+        return len(a & b) / len(a | b) if a | b else None
+
+    gap = []
+    if owned is not None:
+        for doc in documents:
+            role = doc["facts"]["role"]
+            if role is None or role["id"] != target:
+                continue
+            for group in doc["facts"]["requirements"]:
+                members = set(group["skills"])
+                if (
+                    group["operator"] == "AND"
+                    and group["requirement_type"] == "required"
+                ):
+                    status = "covered" if members <= owned else "missing_skills"
+                elif (
+                    group["operator"] == "OR"
+                    and group["requirement_type"] == "required"
+                ):
+                    status = "covered" if members & owned else "missing_any_one"
+                else:
+                    status = "context_only"
+                gap.append(
+                    {
+                        "jd_id": doc["job"].jd_id,
+                        **group,
+                        "status": status,
+                        "missing": sorted(members - owned)
+                        if status == "missing_skills"
+                        else [],
+                    }
+                )
+    return {
+        "source_role": source,
+        "target_role": target,
+        "shared_skills": sorted(left_skills & right_skills),
+        "target_only_skill_mentions": sorted(right_skills - left_skills),
+        "shared_tasks": sorted(left_tasks & right_tasks),
+        "target_only_tasks": sorted(right_tasks - left_tasks),
+        "skill_jaccard": jaccard(left_skills, right_skills),
+        "task_jaccard": jaccard(left_tasks, right_tasks),
+        "requirement_group_checks": gap,
+        "source_jd_count": left["role"]["total_jd_count"],
+        "target_jd_count": right["role"]["total_jd_count"],
+        "scope": "岗位样本重合度不是转岗成功率；只有用户明确提供的技能用于缺口检查，不从原岗位推断个人能力；技能名覆盖不能证明熟练程度、学历或经验达标。",
+        "career_path": {
+            "status": "insufficient_evidence",
+            "reason": "JD不足以证明晋升或转岗路径，未生成Role-Role关系。",
+        },
+    }
