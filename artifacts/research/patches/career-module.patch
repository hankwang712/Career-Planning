@@ -0,0 +1,260 @@
+from __future__ import annotations
+
+import hashlib
+import re
+from datetime import date
+from typing import Literal
+
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+
+from .catalog import CareerCatalog
+
+SCHEMA_VERSION = "career-v1"
+Level = Literal["intern", "junior", "mid", "senior", "lead", "unspecified"]
+Operator = Literal["AND", "OR", "EXAMPLE_SET", "ALTERNATIVE_UNCONFIRMED"]
+RequirementType = Literal["required", "preferred", "mentioned", "negated", "uncertain"]
+LEVEL_NAMES = {
+    "intern": "实习",
+    "junior": "初级",
+    "mid": "中级",
+    "senior": "高级",
+    "lead": "负责人",
+    "unspecified": "层级未注明",
+}
+LEVEL_CUES = {
+    "intern": r"实习|\bintern\b",
+    "junior": r"初级|\bjunior\b",
+    "mid": r"中级|\bmid(?:dle)?\b",
+    "senior": r"高级|资深|\bsenior\b",
+    "lead": r"负责人|主管|总监|\blead\b|\bprincipal\b",
+}
+
+
+class StrictModel(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+
+
+class JobRecord(StrictModel):
+    jd_id: str = Field(min_length=1)
+    record: int = Field(ge=1)
+    text: str = Field(min_length=1)
+    file_path: str = Field(min_length=1)
+    title: str = Field(min_length=1)
+    company: str
+    city: str
+    education: str
+    published_at: str | None = None
+
+    @model_validator(mode="after")
+    def check_date(self):
+        if self.published_at is not None:
+            date.fromisoformat(self.published_at)
+        return self
+
+    @property
+    def chunk_text(self) -> str:
+        return f"招聘记录内部键：{self.jd_id}\n{self.text}"
+
+    @property
+    def content_hash(self) -> str:
+        return hashlib.sha256(self.text.encode()).hexdigest()
+
+
+class RoleCandidate(StrictModel):
+    family: str = Field(min_length=1)
+    level: Level = "unspecified"
+    evidence: list[str] = Field(min_length=1)
+    level_evidence: list[str] = Field(default_factory=list)
+
+
+class SkillCandidate(StrictModel):
+    name: str = Field(min_length=1)
+    category: Literal[
+        "language",
+        "framework",
+        "tool",
+        "platform",
+        "method",
+        "soft_skill",
+        "domain",
+        "other",
+    ]
+    evidence: list[str] = Field(min_length=1)
+
+
+class SkillUse(StrictModel):
+    skill: str
+    evidence: list[str] = Field(min_length=1)
+
+
+class TaskCandidate(StrictModel):
+    name: str = Field(min_length=1)
+    evidence: list[str] = Field(min_length=1)
+    uses: list[SkillUse] = Field(default_factory=list)
+
+
+class RequirementGroup(StrictModel):
+    skills: list[str] = Field(min_length=1)
+    operator: Operator
+    requirement_type: RequirementType
+    proficiency: str | None = None
+    evidence: list[str] = Field(min_length=1)
+
+
+class CareerExtraction(StrictModel):
+    role: RoleCandidate | None
+    skills: list[SkillCandidate]
+    tasks: list[TaskCandidate]
+    requirements: list[RequirementGroup]
+
+
+def _quotes(quotes: list[str], text: str) -> list[dict]:
+    result = []
+    for quote in dict.fromkeys(quotes):
+        if not quote.strip() or quote not in text:
+            raise ValueError(
+                f"Extraction evidence must be a literal nonempty substring of the JD; invalid quote={quote[:300]!r}"
+            )
+        start = text.index(quote)
+        result.append({"quote": quote, "start": start, "end": start + len(quote)})
+    return result
+
+
+def normalize_extraction(
+    raw: CareerExtraction, job: JobRecord, catalog: CareerCatalog
+) -> dict:
+    """Validate every quote and reference before accepting any part of an extraction."""
+    role = None
+    if raw.role is not None:
+        if raw.role.family not in catalog.roles:
+            raise ValueError("Role family is outside the controlled catalog")
+        evidence = _quotes(raw.role.evidence, job.text)
+        # A title match alone cannot classify a role family.
+        body_start = job.text.find("岗位描述：")
+        if body_start < 0 or not any(
+            q["start"] >= body_start + len("岗位描述：") for q in evidence
+        ):
+            raise ValueError(
+                "Role classification needs responsibility evidence from the JD body"
+            )
+        level_evidence = _quotes(raw.role.level_evidence, job.text)
+        if raw.role.level != "unspecified" and not level_evidence:
+            raise ValueError("A career level requires explicit level evidence")
+        if raw.role.level != "unspecified" and not any(
+            re.search(LEVEL_CUES[raw.role.level], q["quote"], re.I)
+            for q in level_evidence
+        ):
+            raise ValueError("Career level evidence does not name the selected level")
+        role = {
+            "id": f"Role::{raw.role.family}::{raw.role.level}",
+            "family": raw.role.family,
+            "name": catalog.roles[raw.role.family]["name"],
+            "level": raw.role.level,
+            "evidence": evidence,
+            "level_evidence": level_evidence,
+        }
+    skills, refs = {}, {}
+    for skill in raw.skills:
+        name = catalog.canonical("Skill", skill.name)
+        refs[skill.name] = name
+        refs[name] = name
+        entry = skills.setdefault(
+            name,
+            {"id": f"Skill::{name}", "name": name, "categories": [], "evidence": []},
+        )
+        if skill.category not in entry["categories"]:
+            entry["categories"].append(skill.category)
+        entry["evidence"].extend(_quotes(skill.evidence, job.text))
+
+    def resolve_skill_reference(name):
+        if name in refs:
+            return refs[name]
+        canonical = catalog.canonical("Skill", name)
+        if canonical in skills:
+            refs[name] = canonical
+            return canonical
+        raise ValueError(
+            f"Requirement or task references an undeclared skill: {name!r}; declared names={list(skills)}"
+        )
+
+    groups = []
+    for index, group in enumerate(raw.requirements):
+        members = list(
+            dict.fromkeys(resolve_skill_reference(name) for name in group.skills)
+        )
+        if (
+            group.operator != "AND"
+            and len(members) < 2
+            and group.operator != "EXAMPLE_SET"
+        ):
+            raise ValueError(
+                "An alternative group must contain at least two distinct skills"
+            )
+        evidence = _quotes(group.evidence, job.text)
+        if group.operator == "AND" and group.requirement_type == "required":
+            # Guard slash alternatives even if they become singleton groups.
+            for quote in group.evidence:
+                for member in group.skills:
+                    other_names = [name for name in refs if refs[name] not in members]
+                    if any(
+                        re.search(
+                            rf"(?:{re.escape(member)}\s*[/／]\s*{re.escape(other)}|{re.escape(other)}\s*[/／]\s*{re.escape(member)})",
+                            quote,
+                            re.I,
+                        )
+                        for other in other_names
+                    ):
+                        raise ValueError(
+                            "A slash alternative cannot become an individual required skill"
+                        )
+                for i, member in enumerate(group.skills):
+                    if any(
+                        re.search(
+                            rf"(?:{re.escape(member)}\s*[/／]\s*{re.escape(other)}|{re.escape(other)}\s*[/／]\s*{re.escape(member)})",
+                            quote,
+                            re.I,
+                        )
+                        for other in group.skills[i + 1 :]
+                    ):
+                        raise ValueError(
+                            "A slash alternative cannot become an AND requirement"
+                        )
+        if group.proficiency and not any(
+            group.proficiency in q["quote"] for q in evidence
+        ):
+            raise ValueError("Proficiency must appear in the requirement evidence")
+        groups.append(
+            {
+                "group_id": f"{job.jd_id}:requirement:{index}",
+                "skills": members,
+                "operator": group.operator,
+                "requirement_type": group.requirement_type,
+                "proficiency": group.proficiency,
+                "evidence": evidence,
+            }
+        )
+    tasks = {}
+    for task in raw.tasks:
+        name = catalog.canonical("Task", task.name)
+        entry = tasks.setdefault(
+            name, {"id": f"Task::{name}", "name": name, "evidence": [], "uses": []}
+        )
+        entry["evidence"].extend(_quotes(task.evidence, job.text))
+        for use in task.uses:
+            skill_name = resolve_skill_reference(use.skill)
+            entry["uses"].append(
+                {"skill": skill_name, "evidence": _quotes(use.evidence, job.text)}
+            )
+    referenced = {name for group in groups for name in group["skills"]}
+    referenced.update(use["skill"] for task in tasks.values() for use in task["uses"])
+    if set(skills) - referenced:
+        raise ValueError(
+            "Every skill needs a requirement group or an explicit task-use observation"
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "role": role,
+        "skills": list(skills.values()),
+        "tasks": list(tasks.values()),
+        "requirements": groups,
+    }
