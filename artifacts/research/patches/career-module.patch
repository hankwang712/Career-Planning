+from __future__ import annotations
+
+import copy
+from datetime import datetime, timezone
+import hashlib
+import json
+import re
+import uuid
+
+
+def canonical_id(identifier: str) -> str:
+    kind = identifier.split("::", 1)[0].lower()
+    return f"career_{kind}_" + hashlib.sha256(identifier.encode()).hexdigest()[:24]
+
+
+def initialize_registry(db):
+    db.executescript("""
+        CREATE TABLE IF NOT EXISTS career_entities (
+            workspace TEXT NOT NULL, id TEXT NOT NULL, canonical_id TEXT NOT NULL,
+            entity_type TEXT NOT NULL, name TEXT NOT NULL, redirect_to TEXT,
+            PRIMARY KEY(workspace,id), UNIQUE(workspace,canonical_id)
+        );
+        CREATE TABLE IF NOT EXISTS career_entity_merges (
+            sequence INTEGER PRIMARY KEY AUTOINCREMENT, workspace TEXT NOT NULL,
+            merge_id TEXT NOT NULL UNIQUE, payload_json TEXT NOT NULL,
+            active INTEGER NOT NULL DEFAULT 1, created_at TEXT NOT NULL, reverted_at TEXT
+        );
+        CREATE TABLE IF NOT EXISTS career_merge_reviews (
+            workspace TEXT NOT NULL, cache_key TEXT NOT NULL,
+            input_json TEXT NOT NULL, response_text TEXT NOT NULL, result_json TEXT,
+            created_at TEXT NOT NULL, PRIMARY KEY(workspace,cache_key)
+        );
+        CREATE TABLE IF NOT EXISTS career_merge_runs (
+            workspace TEXT NOT NULL, run_id TEXT NOT NULL, report_json TEXT NOT NULL,
+            PRIMARY KEY(workspace,run_id)
+        );
+        CREATE TABLE IF NOT EXISTS career_projection_manifest (
+            workspace TEXT PRIMARY KEY, nodes_json TEXT NOT NULL, edges_json TEXT NOT NULL
+        );
+        CREATE TABLE IF NOT EXISTS career_projection_payloads (
+            workspace TEXT NOT NULL, kind TEXT NOT NULL, object_id TEXT NOT NULL, digest TEXT NOT NULL,
+            PRIMARY KEY(workspace,kind,object_id)
+        );
+    """)
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+KNOWN_TECHNOLOGIES = {
+    name.casefold(): name.casefold()
+    for name in (
+        "Python",
+        "Java",
+        "JavaScript",
+        "TypeScript",
+        "C",
+        "C++",
+        "C#",
+        "Go",
+        "Rust",
+        "HTML",
+        "SQL",
+        "Bash",
+        "Dify",
+        "n8n",
+        "FastGPT",
+        "Coze",
+        "AutoGen",
+        "LangChain",
+        "LangGraph",
+        "Cursor",
+        "Claude",
+        "GPT",
+        "ChatGPT",
+        "OpenAI",
+        "DeepSeek",
+        "MCP",
+        "RAG",
+        "GraphRAG",
+        "PyTorch",
+        "TensorFlow",
+        "FastAPI",
+        "Django",
+        "Flask",
+        "Spring Boot",
+        "Docker",
+        "Kubernetes",
+        "PostgreSQL",
+        "MySQL",
+        "MongoDB",
+        "Redis",
+        "Git",
+        "GitHub",
+        "Spark",
+        "Flink",
+        "Kafka",
+        "Hadoop",
+        "Hive",
+        "Polars",
+        "pandas",
+        "NumPy",
+        "SciPy",
+        "scikit-learn",
+    )
+}
+KNOWN_TECHNOLOGIES.update(
+    {"golang": "go", "k8s": "kubernetes", "sklearn": "scikit-learn"}
+)
+
+
+def blocked_pair(a: dict, b: dict) -> bool:
+    if a["entity_type"] != b["entity_type"] or a["entity_type"] not in {
+        "Skill",
+        "Task",
+    }:
+        return True
+    names = {a["name"], b["name"]}
+    if a["entity_type"] == "Skill":
+        identities = [
+            KNOWN_TECHNOLOGIES.get(name.casefold()) for name in (a["name"], b["name"])
+        ]
+        if all(identities) and identities[0] != identities[1]:
+            return True
+    protected = (
+        {"React", "ReAct"},
+        {"React", "ReACT"},
+        {"Java", "JavaScript"},
+        {"LangChain", "LangGraph"},
+        {"C", "C++"},
+        {"C", "C#"},
+        {"C++", "C#"},
+    )
+    if any(names == pair for pair in protected):
+        return True
+    folded = {name.casefold() for name in names}
+    if any(
+        folded == {name.casefold() for name in pair}
+        for pair in protected
+        if pair not in ({"React", "ReAct"}, {"React", "ReACT"})
+    ):
+        return True
+    if (
+        folded == {"react"}
+        and any(name in {"ReAct", "ReACT"} for name in names)
+        and not names <= {"ReAct", "ReACT"}
+    ):
+        return True
+    # Different version numbers and explicit ownership/negation cannot disappear
+    # through an automatic synonym decision.
+    if re.findall(r"\d+(?:\.\d+)*", a["name"]) != re.findall(
+        r"\d+(?:\.\d+)*", b["name"]
+    ):
+        return True
+    if a["entity_type"] == "Task":
+        for marker in ("独立", "主导", "协助", "不需要", "无需", "禁止"):
+            if (marker in a["name"]) != (marker in b["name"]):
+                return True
+    return False
+
+
+class EntityRegistry:
+    def __init__(self, store):
+        self.store, self.db, self.workspace = store, store.db, store.workspace
+
+    def rows(self) -> dict:
+        rows = self.db.execute(
+            "SELECT * FROM career_entities WHERE workspace=? ORDER BY id",
+            (self.workspace,),
+        )
+        return {row["id"]: dict(row) for row in rows}
+
+    def ensure_entity(self, kind, name):
+        identifier = f"{kind}::{name}"
+        with self.db:
+            self.db.execute(
+                "INSERT OR IGNORE INTO career_entities VALUES (?,?,?,?,?,NULL)",
+                (self.workspace, identifier, canonical_id(identifier), kind, name),
+            )
+        return identifier
+
+    def register(self, documents):
+        values = {}
+        for doc in documents:
+            facts = doc["facts"]
+            if facts["role"]:
+                role = facts["role"]
+                values[role["id"]] = ("Role", role["name"])
+            for kind, key in (("Skill", "skills"), ("Task", "tasks")):
+                for entity in facts[key]:
+                    values[entity["id"]] = (kind, entity["name"])
+        with self.db:
+            self.db.executemany(
+                "INSERT OR IGNORE INTO career_entities VALUES (?,?,?,?,?,NULL)",
+                [
+                    (self.workspace, identifier, canonical_id(identifier), kind, name)
+                    for identifier, (kind, name) in values.items()
+                ],
+            )
+
+    @staticmethod
+    def root(identifier, rows):
+        seen = set()
+        while identifier in rows and rows[identifier]["redirect_to"]:
+            if identifier in seen:
+                raise ValueError("Cyclic career entity redirects")
+            seen.add(identifier)
+            identifier = rows[identifier]["redirect_to"]
+        return identifier
+
+    def resolve_id(self, identifier):
+        rows = self.rows()
+        identifier = {row["canonical_id"]: key for key, row in rows.items()}.get(
+            identifier, identifier
+        )
+        return self.root(identifier, rows)
+
+    def resolve_name(self, kind, name):
+        identifier = self.resolve_id(f"{kind}::{name}")
+        row = self.rows().get(identifier)
+        return row["name"] if row else name
+
+    def entities(self):
+        rows = self.rows()
+        clusters = {}
+        for identifier, row in rows.items():
+            target = self.root(identifier, rows)
+            entry = clusters.setdefault(
+                target, {**rows[target], "aliases": [], "member_ids": []}
+            )
+            entry["aliases"].append(row["name"])
+            entry["member_ids"].append(identifier)
+        return list(clusters.values())
+
+    def resolve_documents(self, documents):
+        rows = self.rows()
+        if not rows:
+            return documents
+        clusters = {entry["id"]: entry for entry in self.entities()}
+        output = []
+        for document in documents:
+            doc = {**document, "facts": copy.deepcopy(document["facts"])}
+            facts = doc["facts"]
+            skill_names = {}
+            skills = {}
+            for entity in facts["skills"]:
+                identifier = self.root(entity["id"], rows)
+                meta = clusters.get(identifier)
+                name = meta["name"] if meta else entity["name"]
+                skill_names[entity["name"]] = name
+                item = skills.setdefault(
+                    identifier,
+                    {
+                        **entity,
+                        "id": identifier,
+                        "name": name,
+                        "canonical_id": canonical_id(identifier),
+                        "aliases": meta["aliases"] if meta else [name],
+                        "evidence": [],
+                        "categories": [],
+                    },
+                )
+                item["evidence"].extend(entity["evidence"])
+                item["categories"] = sorted(
+                    set(item["categories"]) | set(entity["categories"])
+                )
+            facts["skills"] = list(skills.values())
+            for group in facts["requirements"]:
+                group["original_skills"] = group["skills"][:]
+                group["skills"] = list(
+                    dict.fromkeys(skill_names[name] for name in group["skills"])
+                )
+            tasks = {}
+            for entity in facts["tasks"]:
+                identifier = self.root(entity["id"], rows)
+                meta = clusters.get(identifier)
+                item = tasks.setdefault(
+                    identifier,
+                    {
+                        **entity,
+                        "id": identifier,
+                        "name": meta["name"] if meta else entity["name"],
+                        "canonical_id": canonical_id(identifier),
+                        "aliases": meta["aliases"] if meta else [entity["name"]],
+                        "evidence": [],
+                        "uses": [],
+                    },
+                )
+                item["evidence"].extend(entity["evidence"])
+                item["uses"].extend(
+                    {**use, "skill": skill_names[use["skill"]]}
+                    for use in entity["uses"]
+                )
+            facts["tasks"] = list(tasks.values())
+            output.append(doc)
+        return output
+
+    def apply(
+        self,
+        target,
+        sources,
+        *,
+        method,
+        reason,
+        review_keys=None,
+        expected_revision=None,
+    ):
+        """Caller holds the ledger writer lock; mappings and revision commit together."""
+        rows = self.rows()
+        canonical_keys = {row["canonical_id"]: key for key, row in rows.items()}
+        target = canonical_keys.get(target, target)
+        sources = [canonical_keys.get(source, source) for source in sources]
+        if (
+            expected_revision is not None
+            and self.store.state()["revision"] != expected_revision
+        ):
+            raise ValueError(
+                "Merge proposal is stale; inspect the current ledger before applying"
+            )
+        if target not in rows or any(source not in rows for source in sources):
+            raise ValueError("Merge endpoints must exist in the career entity registry")
+        target = self.root(target, rows)
+        sources = sorted({self.root(source, rows) for source in sources} - {target})
+        if not sources:
+            return None
+        if not reason.strip():
+            raise ValueError("A merge requires a reason")
+        for source in sources:
+            if blocked_pair(rows[target], rows[source]):
+                raise ValueError(
+                    "Merge crosses an entity type, role identity, protected concept or qualifier"
+                )
+        identifier = "merge-" + uuid.uuid4().hex
+        payload = {
+            "target": target,
+            "sources": sources,
+            "method": method,
+            "reason": reason,
+            "review_keys": review_keys or [],
+            "revision_before": self.store.state()["revision"],
+        }
+        with self.db:
+            self.db.execute(
+                "INSERT INTO career_entity_merges(workspace,merge_id,payload_json,created_at) VALUES (?,?,?,?)",
+                (
+                    self.workspace,
+                    identifier,
+                    json.dumps(payload, ensure_ascii=False),
+                    now(),
+                ),
+            )
+            self.db.executemany(
+                "UPDATE career_entities SET redirect_to=? WHERE workspace=? AND id=?",
+                [(target, self.workspace, source) for source in sources],
+            )
+            self.db.execute(
+                "UPDATE career_workspaces SET revision=revision+1,projection_status='pending' WHERE workspace=?",
+                (self.workspace,),
+            )
+        return {"merge_id": identifier, **payload}
+
+    def history(self):
+        return [
+            {**dict(row), "payload": json.loads(row["payload_json"])}
+            for row in self.db.execute(
+                "SELECT * FROM career_entity_merges WHERE workspace=? ORDER BY sequence DESC",
+                (self.workspace,),
+            )
+        ]
+
+    def automatic_blocks(self):
+        blocks = set()
+        rows = self.rows()
+        for row in self.history():
+            if not row["active"]:
+                members = [row["payload"]["target"], *row["payload"]["sources"]]
+                for index, member in enumerate(members):
+                    blocks.update(
+                        frozenset((member, other)) for other in members[index + 1 :]
+                    )
+                    blocks.update(
+                        frozenset((self.root(member, rows), self.root(other, rows)))
+                        for other in members[index + 1 :]
+                        if self.root(member, rows) != self.root(other, rows)
+                    )
+        # A later representative-level comparison cannot silently override a
+        # previous distinction between members of the two merge clusters.
+        for row in self.db.execute(
+            "SELECT input_json,result_json FROM career_merge_reviews WHERE workspace=? AND result_json IS NOT NULL",
+            (self.workspace,),
+        ):
+            inputs = {
+                pair["pair_id"]: pair for pair in json.loads(row["input_json"])["pairs"]
+            }
+            for review in json.loads(row["result_json"]):
+                if review["relation"] in {"different", "broader_narrower", "related"}:
+                    pair = inputs[review["pair_id"]]
+                    a, b = pair["a"]["id"], pair["b"]["id"]
+                    blocks.add(frozenset((a, b)))
+                    a, b = self.root(a, rows), self.root(b, rows)
+                    if a != b:
+                        blocks.add(frozenset((a, b)))
+        return blocks
+
+    def undo(self, merge_id):
+        active = [row for row in self.history() if row["active"]]
+        if not active or active[0]["merge_id"] != merge_id:
+            raise ValueError(
+                "Undo the most recent active merge first to preserve redirect dependencies"
+            )
+        with self.db:
+            self.db.execute(
+                "UPDATE career_entity_merges SET active=0,reverted_at=? WHERE workspace=? AND merge_id=?",
+                (now(), self.workspace, merge_id),
+            )
+            self.db.execute(
+                "UPDATE career_entities SET redirect_to=NULL WHERE workspace=?",
+                (self.workspace,),
+            )
+            for row in reversed(active[1:]):
+                payload = row["payload"]
+                self.db.executemany(
+                    "UPDATE career_entities SET redirect_to=? WHERE workspace=? AND id=?",
+                    [
+                        (payload["target"], self.workspace, source)
+                        for source in payload["sources"]
+                    ],
+                )
+            self.db.execute(
+                "UPDATE career_workspaces SET revision=revision+1,projection_status='pending' WHERE workspace=?",
+                (self.workspace,),
+            )
+        return {"reverted_merge_id": merge_id}
+
+    def save_run(self, report):
+        with self.db:
+            self.db.execute(
+                "INSERT OR REPLACE INTO career_merge_runs VALUES (?,?,?)",
+                (
+                    self.workspace,
+                    report["run_id"],
+                    json.dumps(report, ensure_ascii=False),
+                ),
+            )
+
+    def latest_run(self):
+        row = self.db.execute(
+            "SELECT report_json FROM career_merge_runs WHERE workspace=? ORDER BY rowid DESC LIMIT 1",
+            (self.workspace,),
+        ).fetchone()
+        return json.loads(row[0]) if row else None
+
+    def manifest(self):
+        row = self.db.execute(
+            "SELECT * FROM career_projection_manifest WHERE workspace=?",
+            (self.workspace,),
+        ).fetchone()
+        return (
+            {
+                "nodes": json.loads(row["nodes_json"]),
+                "edges": json.loads(row["edges_json"]),
+            }
+            if row
+            else {"nodes": [], "edges": []}
+        )
+
+    def payloads(self):
+        return {
+            (row["kind"], row["object_id"]): row["digest"]
+            for row in self.db.execute(
+                "SELECT * FROM career_projection_payloads WHERE workspace=?",
+                (self.workspace,),
+            )
+        }
+
+    def save_payloads(self, payloads):
+        with self.db:
+            self.db.execute(
+                "DELETE FROM career_projection_payloads WHERE workspace=?",
+                (self.workspace,),
+            )
+            self.db.executemany(
+                "INSERT INTO career_projection_payloads VALUES (?,?,?,?)",
+                [
+                    (self.workspace, kind, identifier, digest)
+                    for (kind, identifier), digest in payloads.items()
+                ],
+            )
+
+    def save_manifest(self, nodes, edges):
+        with self.db:
+            self.db.execute(
+                "INSERT OR REPLACE INTO career_projection_manifest VALUES (?,?,?)",
+                (
+                    self.workspace,
+                    json.dumps(sorted(nodes)),
+                    json.dumps(sorted([list(pair) for pair in edges])),
+                ),
+            )
