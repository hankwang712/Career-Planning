+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from pathlib import Path
+
+
+DEFAULT_ROLES = {
+    "python_backend": {
+        "name": "Python后端开发",
+        "scope": "以Python服务端、接口、后端系统开发为主要职责",
+    },
+    "python_automation": {
+        "name": "Python自动化开发",
+        "scope": "以Python脚本、自动化流程、工具开发为主要职责",
+    },
+    "ai_application": {
+        "name": "AI应用开发",
+        "scope": "以大模型应用、RAG、智能体、AI工作流开发和集成为主要职责",
+    },
+    "algorithm": {
+        "name": "算法研发",
+        "scope": "以算法或机器学习模型训练、优化和评估为主要职责",
+    },
+    "data_engineering": {
+        "name": "数据工程",
+        "scope": "以数据管道、ETL、数据平台建设为主要职责",
+    },
+    "data_analysis": {
+        "name": "数据分析",
+        "scope": "以数据分析、业务洞察和统计报告为主要职责",
+    },
+    "frontend": {"name": "前端开发", "scope": "以浏览器前端界面和交互开发为主要职责"},
+    "java_backend": {
+        "name": "Java后端开发",
+        "scope": "以Java服务端、接口和业务系统开发为主要职责",
+    },
+    "testing": {
+        "name": "软件测试",
+        "scope": "以测试设计、测试执行和自动化测试为主要职责",
+    },
+    "platform_operations": {
+        "name": "平台运维",
+        "scope": "以部署、运维、可靠性和基础设施建设为主要职责",
+    },
+}
+DEFAULT_ALIASES = {
+    "Skill": {
+        "Python语言": "Python",
+        "python": "Python",
+        "SQL语言": "SQL",
+        "sql": "SQL",
+        "k8s": "Kubernetes",
+        "kubernetes": "Kubernetes",
+        "pytorch": "PyTorch",
+        "docker": "Docker",
+        "fastapi": "FastAPI",
+        "langchain": "LangChain",
+        "langgraph": "LangGraph",
+        "dify": "Dify",
+        "autogen": "AutoGen",
+        "React.js": "React",
+        "ReactJS": "React",
+        "ReACT": "ReAct",
+        "postgresql": "PostgreSQL",
+        "numpy": "NumPy",
+    },
+    "Task": {},
+}
+
+
+def clean_name(value: str) -> str:
+    value = unicodedata.normalize("NFKC", value)
+    value = "".join(c for c in value if unicodedata.category(c) != "Cf")
+    value = re.sub(r"\s+", " ", value).strip()
+    if not value or any(
+        marker in value for marker in ("<SEP>", "::", '"', "<|", "\x00")
+    ):
+        raise ValueError("Invalid career entity name")
+    return value
+
+
+@dataclass
+class CareerCatalog:
+    roles: dict = field(default_factory=lambda: json.loads(json.dumps(DEFAULT_ROLES)))
+    aliases: dict = field(
+        default_factory=lambda: json.loads(json.dumps(DEFAULT_ALIASES))
+    )
+
+    def __post_init__(self):
+        if not self.roles:
+            raise ValueError("The role catalog cannot be empty")
+        for key, role in self.roles.items():
+            if not re.fullmatch(r"[a-z][a-z0-9_]*", key):
+                raise ValueError(f"Invalid role catalog key: {key}")
+            clean_name(role["name"])
+            if not isinstance(role.get("scope"), str) or not role["scope"].strip():
+                raise ValueError(f"Missing responsibility scope for role: {key}")
+        for kind, aliases in self.aliases.items():
+            if kind not in {"Skill", "Task"} or not isinstance(aliases, dict):
+                raise ValueError("Aliases must be scoped to Skill or Task")
+            for name, target in aliases.items():
+                clean_name(target)
+                self.canonical(kind, name)
+
+    @classmethod
+    def load(cls, path: Path | None = None) -> CareerCatalog:
+        if path is None:
+            return cls()
+        data = json.loads(path.read_text(encoding="utf-8-sig"))
+        return cls(roles=data["roles"], aliases=data.get("aliases", DEFAULT_ALIASES))
+
+    def canonical(self, kind: str, name: str) -> str:
+        name = clean_name(name)
+        aliases = self.aliases.get(kind, {})
+        seen = set()
+        while name in aliases:
+            target = clean_name(aliases[name])
+            if target == name:
+                break
+            if name in seen:
+                raise ValueError("Cyclic career aliases")
+            seen.add(name)
+            name = target
+        return name
+
+    @property
+    def fingerprint(self) -> str:
+        data = json.dumps(
+            {"roles": self.roles, "aliases": self.aliases},
+            ensure_ascii=False,
+            sort_keys=True,
+        )
+        return hashlib.sha256(data.encode()).hexdigest()
