+import asyncio
+from itertools import islice
+
+from openai import APIConnectionError
+from tenacity import RetryError
+
+from .aggregate import aggregate, compare_roles, profile, similar_roles
+from .extraction import extract_job
+from .projection import project, validate_target
+from .registry import EntityRegistry
+from .merging import merge
+
+
+class ModelServiceUnavailable(RuntimeError):
+    pass
+
+
+def _provider_failure(error):
+    visited = set()
+    while error is not None and id(error) not in visited:
+        visited.add(id(error))
+        if isinstance(error, (APIConnectionError, TimeoutError, ConnectionError)):
+            return error
+        status = getattr(error, "status_code", None)
+        if isinstance(status, int) and (status in {401, 403, 408, 409, 429} or status >= 500):
+            return error
+        if isinstance(error, RetryError):
+            error = error.last_attempt.exception()
+        else:
+            error = error.__cause__
+    return None
+
+
+class CareerService:
+    def __init__(self, store, catalog, rag=None):
+        self.store, self.catalog, self.rag = store, catalog, rag
+        if store.state()["catalog_hash"] != catalog.fingerprint:
+            raise ValueError("Career service catalog differs from the ledger catalog")
+
+    async def ingest(
+        self,
+        jobs,
+        *,
+        retry_failed=False,
+        publish=True,
+        progress=None,
+        merge_mode="rules",
+        merge_options=None,
+        extract_workers=1,
+    ) -> dict:
+        if self.rag is None:
+            raise ValueError("Ingestion requires an initialized LightRAG instance")
+        if type(extract_workers) is not int or not 1 <= extract_workers <= 2:
+            raise ValueError("extract_workers must be 1 or 2")
+        with self.store.writer():
+            await validate_target(self.rag, self.store)
+            result = {"extracted": 0, "existing": 0, "failed": 0, "skipped_failed": 0}
+            async def process_job(job):
+                row = self.store.stage(job)
+                if row["status"] == "extracted":
+                    result["existing"] += 1
+                elif row["status"] == "failed" and not retry_failed:
+                    result["skipped_failed"] += 1
+                else:
+                    try:
+                        limit = self.rag.embedding_func.max_token_size
+                        tokens = len(self.rag.tokenizer.encode(job.chunk_text))
+                        if limit and tokens > limit:
+                            raise ValueError(
+                                f"Complete JD has {tokens} tokens, above limit {limit}; no truncation performed"
+                            )
+                        facts = await extract_job(
+                            self.rag.role_llm_funcs["extract"],
+                            job,
+                            self.catalog,
+                            on_attempt=lambda attempt,
+                            response,
+                            error: self.store.record_extraction_attempt(
+                                job.jd_id, attempt, response, error
+                            ),
+                        )
+                        self.store.accept(job.jd_id, facts, self.rag.llm_model_name)
+                        result["extracted"] += 1
+                    except Exception as error:
+                        self.store.fail(
+                            job.jd_id, f"{type(error).__name__}: {error}"[:2000]
+                        )
+                        result["failed"] += 1
+                        provider_failure = _provider_failure(error)
+                        if provider_failure is not None:
+                            if progress:
+                                progress(result)
+                            status = getattr(provider_failure, "status_code", None)
+                            reason = f"HTTP {status}" if status else type(provider_failure).__name__
+                            raise ModelServiceUnavailable(
+                                f"LLM service failure ({reason}) at JD record {job.record}; import stopped. "
+                                "Successfully extracted records are saved. After service recovery or "
+                                "provider reconfiguration, resume the same range with --retry-failed."
+                            ) from error
+                if progress:
+                    progress(result)
+
+            jobs = iter(jobs)
+            while batch := list(islice(jobs, extract_workers)):
+                tasks = [asyncio.create_task(process_job(job)) for job in batch]
+                try:
+                    await asyncio.gather(*tasks)
+                finally:
+                    # Do not leave paid requests or ledger writes running after a failure.
+                    for task in tasks:
+                        if not task.done():
+                            task.cancel()
+                    await asyncio.gather(*tasks, return_exceptions=True)
+            if publish:
+                if merge_mode == "semantic":
+                    state = self.store.state()
+                    if (
+                        state["projection_status"] != "complete"
+                        or state["revision"] != state["projected_revision"]
+                    ):
+                        result["initial_projection"] = await project(
+                            self.rag, self.store
+                        )
+                result["merge"] = await merge(
+                    self.store,
+                    self.catalog,
+                    self.rag if merge_mode == "semantic" else None,
+                    mode=merge_mode,
+                    **(merge_options or {}),
+                )
+                state = self.store.state()
+                if (
+                    state["projection_status"] == "complete"
+                    and state["revision"] == state["projected_revision"]
+                ):
+                    result["projection"] = {
+                        "status": "unchanged",
+                        "revision": state["revision"],
+                    }
+                else:
+                    result["projection"] = await project(self.rag, self.store)
+            elif merge_mode != "off":
+                result["merge"] = await merge(self.store, self.catalog, mode="rules")
+            return result
+
+    async def merge(self, *, mode="rules", dry_run=False, publish=True, **options):
+        if not dry_run and publish and self.rag is None:
+            raise ValueError(
+                "Merge publication requires an initialized LightRAG instance"
+            )
+        with self.store.writer():
+            if self.rag is not None:
+                await validate_target(self.rag, self.store)
+                state = self.store.state()
+                if (
+                    mode == "semantic"
+                    and not dry_run
+                    and (
+                        state["projection_status"] != "complete"
+                        or state["revision"] != state["projected_revision"]
+                    )
+                ):
+                    await project(self.rag, self.store)
+            report = await merge(
+                self.store,
+                self.catalog,
+                self.rag,
+                mode=mode,
+                dry_run=dry_run,
+                **options,
+            )
+            if publish and not dry_run:
+                report["projection"] = await project(self.rag, self.store)
+            return report
+
+    async def apply_merge(
+        self, target, sources, *, reason, expected_revision=None, publish=True
+    ):
+        with self.store.writer():
+            registry = EntityRegistry(self.store)
+            registry.register(self.store.documents(raw=True))
+            if publish and self.rag is None:
+                raise ValueError(
+                    "Merge publication requires an initialized LightRAG instance"
+                )
+            if self.rag is not None:
+                await validate_target(self.rag, self.store)
+            report = registry.apply(
+                target,
+                sources,
+                method="manual",
+                reason=reason,
+                expected_revision=expected_revision,
+            )
+            if publish:
+                return {
+                    "merge": report,
+                    "projection": await project(self.rag, self.store),
+                }
+            return report
+
+    async def undo_merge(self, merge_id, *, publish=True):
+        with self.store.writer():
+            if publish and self.rag is None:
+                raise ValueError(
+                    "Merge publication requires an initialized LightRAG instance"
+                )
+            if self.rag is not None:
+                await validate_target(self.rag, self.store)
+            report = EntityRegistry(self.store).undo(merge_id)
+            if publish:
+                report["projection"] = await project(self.rag, self.store)
+            return report
+
+    async def publish(self):
+        if self.rag is None:
+            raise ValueError("Publishing requires an initialized LightRAG instance")
+        with self.store.writer():
+            return await project(self.rag, self.store, force_reindex=True)
+
+    def roles(self, **filters):
+        graph = aggregate(self.store.documents(**filters))
+        return [
+            {
+                "id": node["id"],
+                "name": node["name"],
+                "total_jd_count": node["total_jd_count"],
+            }
+            for node in graph["nodes"].values()
+            if node["entity_type"] == "Role"
+        ]
+
+    def profile(self, role_id, **filters):
+        return profile(aggregate(self.store.documents(**filters)), role_id)
+
+    def roles_for_skill(self, skill, **filters):
+        name = self.catalog.canonical("Skill", skill)
+        identifier = EntityRegistry(self.store).resolve_id("Skill::" + name)
+        graph = aggregate(self.store.documents(**filters))
+        return [
+            edge
+            for edge in graph["edges"].values()
+            if edge["relation_type"] == "REQUIRES_SKILL"
+            and edge["target"] == identifier
+            and edge["support_jd_count"] > 0
+        ]
+
+    def similar(self, role_id, *, limit=10, **filters):
+        return similar_roles(aggregate(self.store.documents(**filters)), role_id, limit)
+
+    def compare(self, source, target, *, owned=None, **filters):
+        owned = (
+            {
+                EntityRegistry(self.store).resolve_name(
+                    "Skill", self.catalog.canonical("Skill", name)
+                )
+                for name in owned
+            }
+            if owned is not None
+            else None
+        )
+        return compare_roles(self.store.documents(**filters), source, target, owned)
