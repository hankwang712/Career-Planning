+from __future__ import annotations
+
+from contextlib import contextmanager
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+
+from .models import JobRecord, SCHEMA_VERSION
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+class CareerStore:
+    def __init__(self, path: Path, workspace: str, catalog_hash: str):
+        if not workspace.strip():
+            raise ValueError("Career knowledge requires an explicit workspace")
+        self.path, self.workspace = Path(path), workspace
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.db = sqlite3.connect(self.path, timeout=5)
+        self.db.row_factory = sqlite3.Row
+        self.db.executescript("""
+            PRAGMA journal_mode=WAL;
+            CREATE TABLE IF NOT EXISTS career_workspaces (
+                workspace TEXT PRIMARY KEY, schema_version TEXT NOT NULL, catalog_hash TEXT NOT NULL,
+                revision INTEGER NOT NULL DEFAULT 0, projected_revision INTEGER NOT NULL DEFAULT -1,
+                projection_status TEXT NOT NULL DEFAULT 'pending', projection_error TEXT
+            );
+            CREATE TABLE IF NOT EXISTS career_documents (
+                workspace TEXT NOT NULL, jd_id TEXT NOT NULL, content_hash TEXT NOT NULL,
+                record_json TEXT NOT NULL, extraction_json TEXT, model TEXT,
+                status TEXT NOT NULL, error TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
+                PRIMARY KEY (workspace, jd_id)
+            );
+            CREATE INDEX IF NOT EXISTS career_documents_status ON career_documents(workspace,status);
+            CREATE TABLE IF NOT EXISTS career_extraction_attempts (
+                id INTEGER PRIMARY KEY AUTOINCREMENT, workspace TEXT NOT NULL, jd_id TEXT NOT NULL,
+                attempt_number INTEGER NOT NULL, response_text TEXT, error TEXT, created_at TEXT NOT NULL
+            );
+        """)
+        from .registry import initialize_registry
+
+        initialize_registry(self.db)
+        with self.db:
+            self.db.execute(
+                "INSERT OR IGNORE INTO career_workspaces(workspace,schema_version,catalog_hash) VALUES (?,?,?)",
+                (workspace, SCHEMA_VERSION, catalog_hash),
+            )
+        state = self.state()
+        if (
+            state["schema_version"] != SCHEMA_VERSION
+            or state["catalog_hash"] != catalog_hash
+        ):
+            self.db.close()
+            raise ValueError(
+                "Schema or career catalog changed; use a new workspace to avoid mixing role identities"
+            )
+
+    @contextmanager
+    def writer(self):
+        """Hold this process lock throughout an ingest or projection, including awaits."""
+        suffix = hashlib.sha256(self.workspace.encode()).hexdigest()[:16]
+        lock_path = self.path.with_name(f"{self.path.name}.{suffix}.lock")
+        with lock_path.open("a+b") as stream:
+            stream.seek(0, 2)
+            if stream.tell() == 0:
+                stream.write(b"0")
+                stream.flush()
+            stream.seek(0)
+            try:
+                if os.name == "nt":
+                    import msvcrt
+
+                    msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)
+                else:
+                    import fcntl
+
+                    fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except OSError as error:
+                raise RuntimeError(
+                    "Another career import or projection owns this workspace"
+                ) from error
+            try:
+                yield
+            finally:
+                stream.seek(0)
+                if os.name == "nt":
+                    msvcrt.locking(stream.fileno(), msvcrt.LK_UNLCK, 1)
+                else:
+                    fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
+
+    def state(self) -> dict:
+        return dict(
+            self.db.execute(
+                "SELECT * FROM career_workspaces WHERE workspace=?", (self.workspace,)
+            ).fetchone()
+        )
+
+    def get(self, jd_id: str) -> dict | None:
+        row = self.db.execute(
+            "SELECT * FROM career_documents WHERE workspace=? AND jd_id=?",
+            (self.workspace, jd_id),
+        ).fetchone()
+        return dict(row) if row else None
+
+    def stage(self, job: JobRecord) -> dict:
+        row = self.get(job.jd_id)
+        payload = job.model_dump_json()
+        if row:
+            if row["record_json"] != payload:
+                raise ValueError(
+                    "An existing JD identity cannot be reused with changed text or metadata"
+                )
+            return row
+        with self.db:
+            self.db.execute(
+                "INSERT INTO career_documents VALUES (?,?,?,?,NULL,NULL,'pending',NULL,?,?)",
+                (
+                    self.workspace,
+                    job.jd_id,
+                    job.content_hash,
+                    payload,
+                    utc_now(),
+                    utc_now(),
+                ),
+            )
+        return self.get(job.jd_id)
+
+    def accept(self, jd_id: str, facts: dict, model: str):
+        with self.db:
+            cursor = self.db.execute(
+                """UPDATE career_documents SET extraction_json=?, model=?, status='extracted',
+                error=NULL, updated_at=? WHERE workspace=? AND jd_id=? AND status!='extracted'""",
+                (
+                    json.dumps(facts, ensure_ascii=False),
+                    model,
+                    utc_now(),
+                    self.workspace,
+                    jd_id,
+                ),
+            )
+            if cursor.rowcount:
+                self.db.execute(
+                    "UPDATE career_workspaces SET revision=revision+1,projection_status='pending' WHERE workspace=?",
+                    (self.workspace,),
+                )
+
+    def record_extraction_attempt(self, jd_id, attempt, response, error):
+        with self.db:
+            self.db.execute(
+                "INSERT INTO career_extraction_attempts(workspace,jd_id,attempt_number,response_text,error,created_at) VALUES (?,?,?,?,?,?)",
+                (self.workspace, jd_id, attempt, response, error, utc_now()),
+            )
+
+    def fail(self, jd_id: str, error: str):
+        with self.db:
+            self.db.execute(
+                """UPDATE career_documents SET status='failed',error=?,updated_at=?
+                WHERE workspace=? AND jd_id=? AND status!='extracted'""",
+                (error, utc_now(), self.workspace, jd_id),
+            )
+
+    def documents(
+        self,
+        *,
+        city: str | None = None,
+        education: str | None = None,
+        raw: bool = False,
+    ) -> list[dict]:
+        rows = self.db.execute(
+            "SELECT * FROM career_documents WHERE workspace=? AND status='extracted' ORDER BY jd_id",
+            (self.workspace,),
+        )
+        result = []
+        for row in rows:
+            job = JobRecord.model_validate_json(row["record_json"])
+            if (city is not None and job.city != city) or (
+                education is not None and job.education != education
+            ):
+                continue
+            result.append(
+                {
+                    "job": job,
+                    "facts": json.loads(row["extraction_json"]),
+                    "model": row["model"],
+                    "created_at": row["created_at"],
+                }
+            )
+        if raw:
+            return result
+        from .registry import EntityRegistry
+
+        return EntityRegistry(self).resolve_documents(result)
+
+    def projection_started(self):
+        with self.db:
+            self.db.execute(
+                "UPDATE career_workspaces SET projection_status='projecting',projection_error=NULL WHERE workspace=?",
+                (self.workspace,),
+            )
+
+    def projection_finished(self, revision: int):
+        with self.db:
+            self.db.execute(
+                """UPDATE career_workspaces SET projected_revision=?,projection_status='complete',projection_error=NULL
+                WHERE workspace=? AND revision=?""",
+                (revision, self.workspace, revision),
+            )
+
+    def projection_failed(self, error: str):
+        with self.db:
+            self.db.execute(
+                "UPDATE career_workspaces SET projection_status='failed',projection_error=? WHERE workspace=?",
+                (error, self.workspace),
+            )
+
+    def summary(self) -> dict:
+        counts = dict(
+            self.db.execute(
+                "SELECT status,count(*) FROM career_documents WHERE workspace=? GROUP BY status",
+                (self.workspace,),
+            )
+        )
+        docs = self.documents()
+        failures = self.db.execute(
+            "SELECT jd_id,error FROM career_documents WHERE workspace=? AND status='failed' ORDER BY jd_id LIMIT 100",
+            (self.workspace,),
+        )
+        from .registry import EntityRegistry
+
+        registry = EntityRegistry(self)
+        last_run = registry.latest_run()
+        return {
+            **self.state(),
+            "documents_by_status": counts,
+            "failures": [dict(row) for row in failures],
+            "unclassified_jd_count": sum(doc["facts"]["role"] is None for doc in docs),
+            "active_merge_count": sum(
+                bool(row["active"]) for row in registry.history()
+            ),
+            "last_merge_run": (
+                {
+                    key: last_run.get(key)
+                    for key in (
+                        "run_id",
+                        "mode",
+                        "status",
+                        "before",
+                        "after",
+                        "pending_count",
+                        "revision_after",
+                        "failure",
+                    )
+                }
+                | {
+                    "applied_count": len(last_run.get("applied", [])),
+                    "error_count": len(last_run.get("errors", [])),
+                }
+            )
+            if last_run
+            else None,
+        }
+
+    def close(self):
+        self.db.close()
