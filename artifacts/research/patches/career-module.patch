@@ -0,0 +1,142 @@
+from pathlib import Path
+
+from fastapi import APIRouter, Depends, HTTPException
+from starlette.concurrency import run_in_threadpool
+from starlette.responses import JSONResponse
+
+from .catalog import CareerCatalog
+from .models import StrictModel
+from .service import CareerService
+from .store import CareerStore
+
+
+class Comparison(StrictModel):
+    source_role: str
+    target_role: str
+    owned_skills: list[str] | None = None
+    city: str | None = None
+    education: str | None = None
+
+
+def install_career_api(
+    app, rag, api_key, database: Path, catalog_path: Path | None = None
+):
+    from lightrag.api.utils_api import get_combined_auth_dependency
+
+    catalog = CareerCatalog.load(catalog_path)
+    auth = get_combined_auth_dependency(api_key)
+    router = APIRouter(prefix="/career", tags=["career"], dependencies=[Depends(auth)])
+
+    def run(operation):
+        store = CareerStore(database, rag.workspace, catalog.fingerprint)
+        try:
+            return {
+                "workspace": rag.workspace,
+                "revision": store.state()["revision"],
+                "data": operation(CareerService(store, catalog)),
+            }
+        except ValueError as error:
+            raise HTTPException(status_code=400, detail=str(error)) from error
+        finally:
+            store.close()
+
+    @router.get("/status")
+    def status():
+        return run(lambda service: service.store.summary())
+
+    @router.get("/entities")
+    def entities():
+        from .merging import inventory
+
+        return run(lambda service: list(inventory(service.store).values()))
+
+    @router.get("/merges")
+    def merges():
+        from .registry import EntityRegistry
+
+        def inspect(service):
+            registry = EntityRegistry(service.store)
+            return {"history": registry.history(), "last_run": registry.latest_run()}
+
+        return run(inspect)
+
+    @router.get("/roles")
+    def roles(city: str | None = None, education: str | None = None):
+        return run(lambda service: service.roles(city=city, education=education))
+
+    @router.get("/profile")
+    def role_profile(
+        role_id: str, city: str | None = None, education: str | None = None
+    ):
+        return run(
+            lambda service: service.profile(role_id, city=city, education=education)
+        )
+
+    @router.get("/roles-for-skill")
+    def roles_for_skill(
+        skill: str, city: str | None = None, education: str | None = None
+    ):
+        return run(
+            lambda service: service.roles_for_skill(
+                skill, city=city, education=education
+            )
+        )
+
+    @router.get("/similar-roles")
+    def similar(
+        role_id: str,
+        limit: int = 10,
+        city: str | None = None,
+        education: str | None = None,
+    ):
+        return run(
+            lambda service: service.similar(
+                role_id, limit=limit, city=city, education=education
+            )
+        )
+
+    @router.post("/compare")
+    def compare(request: Comparison):
+        return run(
+            lambda service: service.compare(
+                request.source_role,
+                request.target_role,
+                owned=request.owned_skills,
+                city=request.city,
+                education=request.education,
+            )
+        )
+
+    @app.middleware("http")
+    async def career_boundary(request, call_next):
+        path = request.scope["path"]
+        root = request.scope.get("root_path", "")
+        if root and path.startswith(root + "/"):
+            path = path[len(root) :]
+        if request.method in {"POST", "PUT", "PATCH", "DELETE"} and (
+            (path.startswith("/documents") and path != "/documents/paginated")
+            or path.startswith("/graph")
+        ):
+            return JSONResponse(
+                status_code=409,
+                content={
+                    "detail": "Career graphs are derived from JD facts; use job_graph.py import or career publish."
+                },
+            )
+        if path.startswith(("/query", "/graph", "/api/chat", "/api/generate")):
+            state = await run_in_threadpool(
+                lambda: run(lambda service: service.store.state())
+            )
+            if (
+                state["data"]["projection_status"] != "complete"
+                or state["data"]["revision"] != state["data"]["projected_revision"]
+            ):
+                return JSONResponse(
+                    status_code=503,
+                    content={
+                        "detail": "Career graph projection is incomplete; run career publish before querying."
+                    },
+                )
+        return await call_next(request)
+
+    app.include_router(router)
