{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["static/app-*.js", "src/types/legacy-window.d.ts", "src/types/legacy-dom.d.ts", "src/types/vendor.d.ts"]
}
